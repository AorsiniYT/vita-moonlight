#!/usr/bin/env bash
set -o pipefail

cd "$(dirname "$0")" || exit 1
# shellcheck source=scripts/vita-host.sh
source "scripts/vita-host.sh"

BUILD_TYPE="Release"
USE_GXM="ON"
DO_DEPLOY=1
for arg in "$@"; do
    case "${arg,,}" in
        debug|--debug) BUILD_TYPE="Debug" ;;
        release|--release) BUILD_TYPE="Release" ;;
        gl|--gl) USE_GXM="OFF" ;;
        gxm|--gxm) USE_GXM="ON" ;;
        nodeploy|--no-deploy) DO_DEPLOY=0 ;;
        -h|--help)
            cat <<'EOF'
Usage: ./makefast [--gxm|--gl] [--debug|--release] [--no-deploy]
EOF
            exit 0
            ;;
        *) echo "[makefast] Unknown option: $arg" >&2; exit 2 ;;
    esac
done

vita_host_init || exit 1

backend_suffix="gxm"
[ "$USE_GXM" = "OFF" ] && backend_suffix="gl"
BUILD_DIR="$(vita_build_directory "$backend_suffix")"
EBOOT_PATH="$BUILD_DIR/moonlight.self"
VPK_PATH="$BUILD_DIR/moonlight.vpk"

vita_require_tools cmake git make pkg-config curl sed grep || exit 2
vita_require_sdk || exit 2
vita_fix_msys2_sdk_aliases || exit 2
vita_print_environment
echo "[makefast] Build dir: $BUILD_DIR"
echo "[makefast] Build type: $BUILD_TYPE"

vita_set_build_flags "$BUILD_TYPE"

vita_reset_stale_cmake_cache "$BUILD_DIR" || exit 3

vita_configure_project . "$BUILD_DIR" "$BUILD_TYPE" "$USE_GXM" || exit 3

cmake --build "$BUILD_DIR" --parallel "$VITA_BUILD_JOBS" || exit 4

if [ ! -f "$EBOOT_PATH" ]; then
    echo "[makefast] $EBOOT_PATH was not produced." >&2
    exit 5
fi

if [ ! -f "$VPK_PATH" ]; then
    echo "[makefast] $VPK_PATH was not produced." >&2
    exit 5
fi

echo "[makefast] Build successful: $EBOOT_PATH"
echo "[makefast] VPK: $VPK_PATH"
[ "$DO_DEPLOY" -eq 0 ] && exit 0

IP_FILE="$(pwd)/ip_vita.txt"
if [ ! -f "$IP_FILE" ]; then
    echo "[makefast] ip_vita.txt not found. Copy ip_vita.txt.example and set the Vita address." >&2
    exit 6
fi
PSVITAIP="$(head -n1 "$IP_FILE" | tr -d '\r\n')"
if [ -z "$PSVITAIP" ]; then
    echo "[makefast] ip_vita.txt is empty." >&2
    exit 6
fi
TITLEID="$(vita_title_id)"
if [ -z "$TITLEID" ]; then
    echo "[makefast] Could not read TITLE_ID from CMakeLists.txt." >&2
    exit 6
fi

if ! vita_ping "$PSVITAIP"; then
    echo "[makefast] Vita is not reachable at $PSVITAIP" >&2
    exit 6
fi
if ! command -v nc >/dev/null 2>&1; then
    echo "[makefast] nc/netcat is required for deployment." >&2
    exit 6
fi

(echo destroy | nc "$PSVITAIP" 1338) >/dev/null 2>&1 || true
sleep 1
curl --fail --ftp-method nocwd -T "$EBOOT_PATH" "ftp://$PSVITAIP:1337/ux0:/app/$TITLEID/eboot.bin" || exit 7
launch_response="$(echo "launch $TITLEID" | nc "$PSVITAIP" 1338 2>/dev/null || true)"
echo "[makefast] Vita Companion: ${launch_response:-no response}"
