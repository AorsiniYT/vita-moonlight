<brls:Box width="auto" height="auto">
    <brls:ScrollingFrame width="auto" height="auto" axis="column" alignItems="stretch" grow="1.0">
        <brls:Box axis="column" padding="32">
            <brls:Label text="@i18n/moonlight/settings/add_host_desc" fontSize="20" marginBottom="16" />
            <brls:InputCell id="ip_field" title="@i18n/moonlight/settings/ip" marginBottom="8" />
            <brls:InputCell id="name_field" title="@i18n/moonlight/settings/add_host_manual" marginBottom="8" />
            <brls:SelectorCell id="prefer_external_selector" title="@i18n/moonlight/settings/add_host_connection_type" marginBottom="16" />
            <brls:Button id="add_button" text="@i18n/moonlight/settings/add_host" marginBottom="24" />
            <brls:Box height="2" backgroundColor="#CCCCCC" marginBottom="16" />
            <!-- <brls:Label text="@i18n/moonlight/settings/hosts_list_title" fontSize="18" marginBottom="8" /> -->
            <brls:Box id="hosts_list" axis="column" marginBottom="16">
                <brls:Box id="spinner_row" axis="row" alignItems="center" margin="8 0 8 0" justifyContent="center">
                    <brls:ProgressSpinner id="spinner" width="32" height="32" marginRight="12" />
                    <brls:Label id="search_label" text="@i18n/moonlight/settings/add_host_auto" fontSize="16" />
                </brls:Box>
            </brls:Box>
            <!-- <brls:Label text="@i18n/moonlight/settings/add_host_auto" fontSize="18" marginBottom="8" /> -->
            <!-- <brls:Label id="found_devices_label" text="@i18n/moonlight/settings/add_host_not_implemented" fontSize="16" /> -->
        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
