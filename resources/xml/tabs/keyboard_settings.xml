<?xml version="1.0" encoding="utf-8"?>
<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        scrollingBehavior="centered"
        grow="1.0">

        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/sidebar/padding_top"
            paddingRight="@style/brls/sidebar/padding_right"
            paddingBottom="@style/brls/sidebar/padding_bottom"
            paddingLeft="@style/brls/sidebar/padding_left">

            <!-- Keyboard Mode -->
            <brls:Header
                title="@i18n/moonlight/keyboard/header_mode"
                marginBottom="10"/>
            
            <brls:SelectorCell
                id="keyboard_mode_selector"
                marginBottom="20"/>

            <!-- Keyboard Layout -->
            <brls:Header
                id="keyboard_layout_header"
                title="@i18n/moonlight/keyboard/header_layout"
                marginBottom="10"/>
            
            <brls:SelectorCell
                id="keyboard_layout_selector"
                marginBottom="20"/>

            <!-- Modern Keyboard Options -->
            <brls:Header
                id="keyboard_modern_header"
                title="@i18n/moonlight/keyboard/header_modern"
                marginBottom="10"/>

            <brls:BooleanCell
                id="keyboard_numbers_toggle"
                title="@i18n/moonlight/keyboard/numbers_row_title"/>

            <brls:BooleanCell
                id="keyboard_arrows_toggle"
                title="@i18n/moonlight/keyboard/arrows_title"
                marginBottom="20"/>

            <!-- Theme Settings (Future) -->
            <brls:Header
                id="keyboard_theme_header"
                title="@i18n/moonlight/keyboard/header_theme"
                marginBottom="10"/>
            
            <brls:DetailCell
                id="theme_preview"
                title="@i18n/moonlight/keyboard/theme_preview_title"
                marginBottom="10"/>
            
            <brls:DetailCell
                id="theme_editor"
                title="@i18n/moonlight/keyboard/theme_editor_title"
                marginBottom="20"/>
            
            <brls:Label
                id="keyboard_theme_info"
                text="@i18n/moonlight/keyboard/theme_info"
                fontSize="16"
                textColor="#888888"
                marginTop="10"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
