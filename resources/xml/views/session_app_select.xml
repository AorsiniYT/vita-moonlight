<brls:Box
    width="auto"
    height="auto"
    axis="column"
    alignItems="stretch"
    grow="1.0"
    paddingTop="30"
    paddingRight="50"
    paddingBottom="30"
    paddingLeft="50">

    <!-- Título y subtítulo -->
    <brls:Label id="app_select_title" fontSize="22" marginBottom="5" />
    <brls:Label id="app_select_subtitle" fontSize="16" marginBottom="20" />

    <!-- Contenedor principal para la cuadrícula. El GridView se añadirá aquí desde C++ -->
    <brls:Box id="app_grid_container" grow="1.0" justifyContent="center" alignItems="center" />

    <!-- Mensaje cuando no hay apps. También se gestionará desde C++ -->
    <brls:Label id="app_select_empty" visibility="gone" />

</brls:Box>
