#!/usr/bin/env bash
set -o pipefail

cd "$(dirname "$0")" || exit 1
# shellcheck source=scripts/vita-host.sh
source "scripts/vita-host.sh"

if ! vita_host_init; then
    exit 1
fi

IP_FILE="$(pwd)/ip_vita.txt"
VITA_IP="192.168.0.192"
[ -f "$IP_FILE" ] && VITA_IP="$(head -n1 "$IP_FILE" | tr -d '\r\n')"
VITA_PORT=1337
VITA_CONTROL_PORT=1338

USE_GXM="ON"
BUILD_TYPE="Release"
DO_CLEAN=0
NONINTERACTIVE=0
DO_DEPLOY=1

for arg in "$@"; do
    case "${arg,,}" in
        --gxm|gxm) USE_GXM="ON"; NONINTERACTIVE=1 ;;
        --gl|gl) USE_GXM="OFF"; NONINTERACTIVE=1 ;;
        --debug|debug) BUILD_TYPE="Debug"; NONINTERACTIVE=1 ;;
        --release|release) BUILD_TYPE="Release"; NONINTERACTIVE=1 ;;
        --clean|clean) DO_CLEAN=1; NONINTERACTIVE=1 ;;
        --no-deploy|nodeploy) DO_DEPLOY=0; NONINTERACTIVE=1 ;;
        -h|--help)
            cat <<'EOF'
Usage: ./makepsv [gxm|gl] [debug|release] [clean] [nodeploy]

Without arguments, an interactive menu is shown.
Linux and Windows/MSYS2 are supported by the same script.
EOF
            exit 0
            ;;
        *) echo "[!] Unknown option: $arg" >&2; exit 2 ;;
    esac
done

if [ "$NONINTERACTIVE" -eq 0 ]; then
    echo
    echo "=== Moonlight PSV Builder ==="
    vita_print_environment
    echo
    echo "Graphics backend:"
    echo "1. GXM (Vita hardware)"
    echo "2. GLES"
    read -r -p "Select [1-2]: " gfx
    [ "$gfx" = "2" ] && USE_GXM="OFF" || USE_GXM="ON"

    echo
    echo "Build mode:"
    echo "1. Incremental Release"
    echo "2. Clean Release"
    echo "3. Incremental Debug"
    read -r -p "Select [1-3]: " mode
    case "$mode" in
        1) BUILD_TYPE="Release" ;;
        2) BUILD_TYPE="Release"; DO_CLEAN=1 ;;
        3) BUILD_TYPE="Debug" ;;
        *) echo "Invalid option."; exit 2 ;;
    esac
fi

backend_suffix="gxm"
[ "$USE_GXM" = "OFF" ] && backend_suffix="gl"
BUILD_DIR="cmake-build-psv-${VITA_BUILD_SUFFIX}-${backend_suffix}"
VPK_PATH="$BUILD_DIR/moonlight_vita.vpk"

if ! vita_require_tools cmake git make pkg-config curl sed grep find; then
    exit 3
fi
if ! vita_require_sdk; then
    exit 3
fi
if ! vita_fix_msys2_sdk_aliases; then
    exit 3
fi

vita_print_environment
echo "[+] Backend:     $backend_suffix"
echo "[+] Build type:  $BUILD_TYPE"
echo "[+] Build dir:   $BUILD_DIR"

if [ "$BUILD_TYPE" = "Debug" ]; then
    export CFLAGS="${CFLAGS:-} -O0 -g -fno-omit-frame-pointer -ffunction-sections -fdata-sections"
    export CXXFLAGS="${CXXFLAGS:-} -O0 -g -fno-omit-frame-pointer -ffunction-sections -fdata-sections"
else
    export CFLAGS="${CFLAGS:-} -O2 -g0 -ffunction-sections -fdata-sections"
    export CXXFLAGS="${CXXFLAGS:-} -O2 -g0 -ffunction-sections -fdata-sections"
fi
export LDFLAGS="${LDFLAGS:-} -Wl,--gc-sections"

if [ "$DO_CLEAN" -eq 1 ] && [ -d "$BUILD_DIR" ]; then
    echo "[+] Removing previous build directory..."
    cmake -E remove_directory "$BUILD_DIR" || exit 4
fi
vita_reset_stale_cmake_cache "$BUILD_DIR" || exit 4

configure_project() {
    echo "[+] Configuring Moonlight..."
    local host_cmake_args=()
    if [ -n "${VITA_PKG_CONFIG_EXECUTABLE:-}" ]; then
        host_cmake_args+=("-DPKG_CONFIG_EXECUTABLE=$VITA_PKG_CONFIG_EXECUTABLE")
    fi
    cmake -S . -B "$BUILD_DIR" -G "$VITA_CMAKE_GENERATOR" \
        -DPLATFORM_PSV=ON \
        -DUSE_SYSTEM_CURL=ON \
        -DUSE_SYSTEM_SDL2=ON \
        -DMPV_NO_FB=ON \
        -DSIMPLE_HIGHLIGHT=ON \
        -DUSE_GXM="$USE_GXM" \
        -DUSE_VITA_SHARK=OFF \
        -DCMAKE_BUILD_TYPE="$BUILD_TYPE" \
        -DCMAKE_TOOLCHAIN_FILE="$VITASDK/share/vita.toolchain.cmake" \
        -DCMAKE_FIND_ROOT_PATH="$VITASDK/arm-vita-eabi" \
        -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
        -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
        -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY \
        "${host_cmake_args[@]}"
}

build_project() {
    echo "[+] Building with $VITA_BUILD_JOBS jobs..."
    cmake --build "$BUILD_DIR" --parallel "$VITA_BUILD_JOBS"
}

find_vpk() {
    if [ -f "$VPK_PATH" ]; then
        return 0
    fi
    local found
    found="$(find "$BUILD_DIR" -maxdepth 1 -type f -name '*.vpk' -print -quit 2>/dev/null)"
    if [ -n "$found" ]; then
        VPK_PATH="$found"
        return 0
    fi
    echo "[!] No VPK was produced in $BUILD_DIR" >&2
    return 1
}

deploy_to_vita() {
    if ! vita_ping "$VITA_IP"; then
        echo "[!] Vita is not reachable at $VITA_IP" >&2
        return 1
    fi
    if ! command -v nc >/dev/null 2>&1; then
        echo "[!] nc/netcat is required for Vita Companion control." >&2
        return 1
    fi

    local title_id vpk_name
    title_id="$(vita_title_id)"
    vpk_name="moonlight_vita_cert.vpk"
    echo "[+] Uploading $VPK_PATH to ux0:/ABM/$vpk_name..."
    curl -sSf -m 10 -Q "MKD ux0:/ABM" "ftp://${VITA_IP}:${VITA_PORT}/" 2>/dev/null || true
    curl --ftp-method nocwd -T "$VPK_PATH" "ftp://${VITA_IP}:${VITA_PORT}/ux0:/ABM/$vpk_name" --connect-timeout 10 || return 1
    echo "launch VITASHELL" | nc "$VITA_IP" "$VITA_CONTROL_PORT" >/dev/null 2>&1 || true
    echo "[+] VPK uploaded. TITLE_ID=${title_id:-unknown}"
}

start_time="$(date +%s)"
if ! configure_project || ! build_project || ! find_vpk; then
    echo "[!] Vita build failed." >&2
    exit 5
fi
end_time="$(date +%s)"
echo "[+] Build completed in $((end_time - start_time)) seconds: $VPK_PATH"

if [ "$DO_DEPLOY" -eq 0 ]; then
    exit 0
fi

if [ "$NONINTERACTIVE" -eq 0 ]; then
    echo
    echo "1. Upload VPK to Vita"
    echo "2. Open build directory"
    echo "3. Exit"
    read -r -p "Select [1-3]: " action
    case "$action" in
        1) deploy_to_vita ;;
        2) vita_open_dir "$BUILD_DIR" ;;
        *) : ;;
    esac
fi
