#!/usr/bin/env bash
set -o pipefail

cd "$(dirname "$0")" || exit 1
# shellcheck source=scripts/vita-host.sh
source "scripts/vita-host.sh"

IP_FILE="$(pwd)/ip_vita.txt"
VITA_PORT=1337
VITA_CONTROL_PORT=1338

USE_GXM="ON"
BUILD_TYPE="Release"
DO_CLEAN=0
NONINTERACTIVE=0
DO_DEPLOY=1

for arg in "$@"; do
    case "${arg,,}" in
        --gxm|gxm) USE_GXM="ON"; NONINTERACTIVE=1 ;;
        --gl|gl) USE_GXM="OFF"; NONINTERACTIVE=1 ;;
        --debug|debug) BUILD_TYPE="Debug"; NONINTERACTIVE=1 ;;
        --release|release) BUILD_TYPE="Release"; NONINTERACTIVE=1 ;;
        --clean|clean) DO_CLEAN=1; NONINTERACTIVE=1 ;;
        --no-deploy|nodeploy) DO_DEPLOY=0; NONINTERACTIVE=1 ;;
        -h|--help)
            cat <<'EOF'
Usage: ./makepsv [--gxm|--gl] [--debug|--release] [--clean] [--no-deploy]

Without arguments, an interactive menu is shown.
Linux, WSL and Windows/MSYS2 are supported by the same script.
EOF
            exit 0
            ;;
        *) echo "[!] Unknown option: $arg" >&2; exit 2 ;;
    esac
done

vita_host_init || exit 1

if [ "$NONINTERACTIVE" -eq 0 ]; then
    echo
    echo "=== Moonlight PSV Builder ==="
    vita_print_environment
    echo
    echo "Graphics backend:"
    echo "1. GXM (Vita hardware)"
    echo "2. GLES"
    read -r -p "Select [1-2]: " gfx
    [ "$gfx" = "2" ] && USE_GXM="OFF" || USE_GXM="ON"

    echo
    echo "Build mode:"
    echo "1. Incremental Release"
    echo "2. Clean Release"
    echo "3. Incremental Debug"
    read -r -p "Select [1-3]: " mode
    case "$mode" in
        1) BUILD_TYPE="Release" ;;
        2) BUILD_TYPE="Release"; DO_CLEAN=1 ;;
        3) BUILD_TYPE="Debug" ;;
        *) echo "Invalid option."; exit 2 ;;
    esac
fi

backend_suffix="gxm"
[ "$USE_GXM" = "OFF" ] && backend_suffix="gl"
BUILD_DIR="$(vita_build_directory "$backend_suffix")"
VPK_PATH="$BUILD_DIR/moonlight.vpk"

if ! vita_require_tools cmake git make pkg-config curl sed grep; then
    exit 3
fi
if ! vita_require_sdk; then
    exit 3
fi
if ! vita_fix_msys2_sdk_aliases; then
    exit 3
fi

vita_print_environment
echo "[+] Backend:     $backend_suffix"
echo "[+] Build type:  $BUILD_TYPE"
echo "[+] Build dir:   $BUILD_DIR"

vita_set_build_flags "$BUILD_TYPE"

if [ "$DO_CLEAN" -eq 1 ] && [ -d "$BUILD_DIR" ]; then
    echo "[+] Removing previous build directory..."
    cmake -E remove_directory "$BUILD_DIR" || exit 4
fi
vita_reset_stale_cmake_cache "$BUILD_DIR" || exit 4

configure_project() {
    echo "[+] Configuring Moonlight..."
    vita_configure_project . "$BUILD_DIR" "$BUILD_TYPE" "$USE_GXM"
}

build_project() {
    echo "[+] Building with $VITA_BUILD_JOBS jobs..."
    cmake --build "$BUILD_DIR" --parallel "$VITA_BUILD_JOBS"
}

find_vpk() {
    if [ ! -f "$VPK_PATH" ]; then
        echo "[!] $VPK_PATH was not produced." >&2
        return 1
    fi
}

deploy_to_vita() {
    if [ ! -f "$IP_FILE" ]; then
        echo "[!] ip_vita.txt not found. Copy ip_vita.txt.example and set the Vita address." >&2
        return 1
    fi

    local vita_ip
    vita_ip="$(head -n1 "$IP_FILE" | tr -d '\r\n')"
    if [ -z "$vita_ip" ]; then
        echo "[!] ip_vita.txt is empty." >&2
        return 1
    fi

    if ! vita_ping "$vita_ip"; then
        echo "[!] Vita is not reachable at $vita_ip" >&2
        return 1
    fi
    if ! command -v nc >/dev/null 2>&1; then
        echo "[!] nc/netcat is required for Vita Companion control." >&2
        return 1
    fi

    local title_id
    title_id="$(vita_title_id)"
    echo "[+] Uploading $VPK_PATH to ux0:/ABM/moonlight.vpk..."
    curl -sSf -m 10 -Q "MKD ux0:/ABM" "ftp://${vita_ip}:${VITA_PORT}/" 2>/dev/null || true
    curl --ftp-method nocwd -T "$VPK_PATH" "ftp://${vita_ip}:${VITA_PORT}/ux0:/ABM/moonlight.vpk" --connect-timeout 10 || return 1
    echo "launch VITASHELL" | nc "$vita_ip" "$VITA_CONTROL_PORT" >/dev/null 2>&1 || true
    echo "[+] VPK uploaded. TITLE_ID=${title_id:-unknown}"
}

start_time="$(date +%s)"
if ! configure_project || ! build_project || ! find_vpk; then
    echo "[!] Vita build failed." >&2
    exit 5
fi
end_time="$(date +%s)"
echo "[+] Build completed in $((end_time - start_time)) seconds: $VPK_PATH"

if [ "$DO_DEPLOY" -eq 0 ]; then
    exit 0
fi

if [ "$NONINTERACTIVE" -eq 0 ]; then
    echo
    echo "1. Upload VPK to Vita"
    echo "2. Open build directory"
    echo "3. Exit"
    read -r -p "Select [1-3]: " action
    case "$action" in
        1) deploy_to_vita ;;
        2) vita_open_dir "$BUILD_DIR" ;;
        *) : ;;
    esac
fi
